msgstr "Prisijungimo langas..."

#: src/userSwitcher.js
msgid "Users & Groups Settings..."
msgstr "Naudotojų ir grupių nustatymai..."

#: app/forceQuitWindow.js
msgid "Force Quit Applications"
msgstr "Priverstinis programų išjungimas"

#: app/forceQuitWindow.js
msgid "If an app doesn't respond for a while, select its name and click Force Quit."
msgstr "Jei programa kurį laiką nereaguoja, pasirinkite jos pavadinimą ir spustelėkite „Priverstinis išjungimas“."

#: app/aboutWindow.js
msgid "Chip"
msgstr "Lustas"

#: app/aboutWindow.js
msgid "Memory"
msgstr "Atmintis"

#: app/aboutWindow.js
msgid "OS"
msgstr "OS"

#: app/aboutWindow.js
msgid "More Info..."
msgstr "Daugiau informacijos..."

#: prefs.js
msgid "Options"
msgstr "Parinktys"

#: prefs.js
msgid "Menu"
msgstr "Meniu"

#: prefs.js
msgid "Adjust how the Kiwi Menu looks and behaves."
msgstr "Pritaikykite Kiwi meniu išvaizdą ir elgesį."

#: prefs.js
msgid "Menu Icon"
msgstr "Meniu piktograma"

#: prefs.js
msgid "App Store Command"
msgstr "Programų parduotuvės komanda"

#: prefs.js
msgid "Command launched when opening the App Store menu item."
msgstr "Komanda paleidžiama atidarant programų parduotuvės meniu elementą."

#: prefs.js
msgid "Menu Item Icons"
msgstr "Meniu elementų piktogramos"

#: prefs.js
msgid "Show icons on every entry, on the top three (About This PC, System Settings, App Store) only, or on none."
msgstr "Rodyti piktogramas visuose elementuose, tik trijuose viršutiniuose (Apie šį kompiuterį, Sistemos nustatymai, Programų parduotuvė) arba nė viename."

#: prefs.js
msgid "Default"
msgstr "Numatytasis"

#: prefs.js
msgid "Three"
msgstr "Trys"

#: prefs.js
msgid "None"
msgstr "Nėra"

#: prefs.js
msgid "Custom Menu Item"
msgstr "Pasirinktinis meniu elementas"

#: prefs.js
msgid "Add a custom menu entry with your own label and command."
msgstr "Pridėkite pasirinktinį meniu įrašą su savo etikete ir komanda."

#: prefs.js
msgid "Menu Label"
msgstr "Meniu etiketė"

#: prefs.js
msgid "Command"
msgstr "Komanda"

#: prefs.js
msgid "Restore Default"
msgstr "Atkurti numatytąjį"

#: prefs.js
msgid "Choose the icon to display in the panel."
msgstr "Pasirinkite piktogramą, kuri bus rodoma skydelyje."

#: prefs.js
msgid "Panel"
msgstr "Skydelis"

#: prefs.js
msgid "Hide or show the Activities button from the top bar."
msgstr "Slėpti arba rodyti veiklos mygtuką viršutinėje juostoje."

#: prefs.js
msgid "Hide Activities Menu"
msgstr "Slėpti veiklos meniu"

#: prefs.js
msgid "Display the Activities button in the top panel."
msgstr "Rodyti veiklos mygtuką viršutiniame skydelyje."

#: prefs.js
msgid "Quick Settings"
msgstr "Greitieji nustatymai"

#: prefs.js
msgid "Choose which default quick action buttons stay visible."
msgstr ""
"Pasirinkite, kurie numatytieji greitųjų veiksmų mygtukai turi likti matomi."

#: prefs.js
msgid "Hide Lock Screen Button"
msgstr "Slėpti užrakinti ekraną mygtuką"

#: prefs.js
msgid "Remove the lock screen quick action button."
msgstr "Pašalina užrakinto ekrano greitojo veiksmo mygtuką."

#: prefs.js
msgid "Hide Power Button"
msgstr "Slėpti maitinimo mygtuką"

#: prefs.js
msgid "Remove the power menu quick action button."
msgstr "Pašalina maitinimo meniu greitojo veiksmo mygtuką."

#: prefs.js
msgid "Hide Settings Button"
msgstr "Slėpti nustatymų mygtuką"

#: prefs.js
msgid "Remove the settings shortcut quick action button."
msgstr "Pašalina nustatymų nuorodos greitojo veiksmo mygtuką."

#: prefs.js
msgid "About"
msgstr "Apie"

#: prefs.js
msgid "Website"
msgstr "Svetainė"

#: prefs.js
msgid "Report an Issue"
msgstr "Pranešti apie problemą"

#: prefs.js
msgid "Credits"
msgstr "Autoriai"

#: prefs.js
msgid "Legal"
msgstr "Teisinė informacija"

#: prefs.js
msgid "License"
msgstr "Licencija"

#: prefs.js
msgid "Kiwi Menu is free and open source software."
msgstr "Kiwi Menu yra nemokama ir atvirojo kodo programinė įranga."

#: prefs.js
msgid "GNU General Public License v3.0"
msgstr "GNU Bendroji Viešoji Licencija v3.0"

#: prefs.js
msgid "Copyright"
msgstr "Autorių teisės"

#: prefs.js
msgid ""
"Copyright © 2026 Arnis Kemlers. Licensed under the terms of the GNU General "
"Public License version 3 or later."
msgstr ""
"Autorių teisės © 2026 Arnis Kemlers. Licencijuota pagal GNU bendrosios "
"viešosios licencijos 3 ar vėlesnės versijos sąlygas."

#: prefs.js
msgid "Become a sponsor on GitHub"
msgstr "Tapk rėmėju GitHub platformoje"

#: prefs.js
msgid "Sponsor Me ♡"
msgstr "Paremk mane ♡"

#: prefs.js
msgid "Apply Changes"
msgstr "Taikyti pakeitimus"

#: prefs.js
msgid "Change log"
msgstr "Pakeitimų žurnalas"

#: prefs.js
msgid "Force Quit Shortcut"
msgstr "Priverstinio išjungimo spartusis klavišas"

#: prefs.js
msgid "Keyboard shortcut that opens the Force Quit window."
msgstr "Spartusis klavišas, atveriantis priverstinio išjungimo langą."

#: prefs.js
msgid "Clear Shortcut"
msgstr "Išvalyti spartųjį klavišą"

#: prefs.js
msgid "Disabled"
msgstr "Išjungta"

#: prefs.js
msgid "macOS Style Shortcuts"
msgstr "macOS stiliaus spartieji klavišai"

#: prefs.js
msgid "Show accelerator hints using macOS symbols (⌘ ⌥ ^ ⎋)."
msgstr "Rodyti sparčiųjų klavišų užuominas macOS simboliais (⌘ ⌥ ^ ⎋)."

#: prefs.js
msgid "Keyboard Shortcut"
msgstr "Spartusis klavišas"

#: prefs.js
msgid "Shortcut that runs the custom command."
msgstr "Spartusis klavišas, vykdantis pasirinktinę komandą."

#: prefs.js
msgid "Set Shortcut"
msgstr "Nustatyti spartųjį klavišą"

#: prefs.js
msgid "Press a Shortcut"
msgstr "Paspauskite spartųjį klavišą"

#: prefs.js
msgid "Esc to cancel · Backspace to disable"
msgstr "Esc atšaukia · Backspace išjungia"

#: prefs.js
msgid "Optional image shown next to the menu label."
msgstr "Neprivalomas paveikslėlis, rodomas šalia meniu etiketės."

#: prefs.js
msgid "Icon"
msgstr "Piktograma"

#: prefs.js
msgid "Choose Icon File"
msgstr "Pasirinkti piktogramos failą"

#: prefs.js
msgid "Remove Icon"
msgstr "Pašalinti piktogramą"

#: prefs.js
msgid "Selected file was not found."
msgstr "Pasirinktas failas nerastas."

#: prefs.js
msgid "Select Custom Menu Icon"
msgstr "Pasirinkti pasirinktinio meniu elemento piktogramą"

#: prefs.js
msgid "Images"
msgstr "Paveikslėliai"

#: src/recentItemsSubmenu.js
msgid "Item unavailable"
msgstr "Elementas nepasiekiamas"

#: src/recentItemsSubmenu.js
#, javascript-format
msgid "Could not open \"%s\"."
msgstr "Nepavyko atverti „%s“."

#: src/recentItemsSubmenu.js
msgid "Application unavailable"
msgstr "Programa nepasiekiama"

#: src/recentItemsSubmenu.js
#, javascript-format
msgid "Could not launch \"%s\"."
msgstr "Nepavyko paleisti „%s“."

