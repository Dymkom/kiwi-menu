msgid "Apply Changes"
msgstr "Zastosuj zmiany"

#: prefs.js
msgid "Change log"
msgstr "Dziennik zmian"

#: prefs.js
msgid "Force Quit Shortcut"
msgstr "Skrót wymuszenia zamknięcia"

#: prefs.js
msgid "Keyboard shortcut that opens the Force Quit window."
msgstr "Skrót klawiszowy otwierający okno wymuszenia zamknięcia."

#: prefs.js
msgid "Clear Shortcut"
msgstr "Wyczyść skrót"

#: prefs.js
msgid "Disabled"
msgstr "Wyłączony"

#: prefs.js
msgid "macOS Style Shortcuts"
msgstr "Skróty w stylu macOS"

#: prefs.js
msgid "Show accelerator hints using macOS symbols (⌘ ⌥ ^ ⎋)."
msgstr "Pokazuj podpowiedzi skrótów z symbolami macOS (⌘ ⌥ ^ ⎋)."

#: prefs.js
msgid "Keyboard Shortcut"
msgstr "Skrót klawiszowy"

