#: prefs.js
msgid "Options"
msgstr "Opcje"

#: prefs.js
msgid "Menu"
msgstr "Menu"

#: prefs.js
msgid "Adjust how the Kiwi Menu looks and behaves."
msgstr "Dostosuj wygląd i zachowanie Kiwi Menu."

#: prefs.js
msgid "Menu Icon"
msgstr "Ikona menu"

#: prefs.js
msgid "App Store Command"
msgstr "Polecenie sklepu z aplikacjami"

#: prefs.js
msgid "Command launched when opening the App Store menu item."
msgstr "Polecenie uruchamiane przy otwieraniu elementu menu App Store."

#: prefs.js
msgid "Menu Item Icons"
msgstr "Ikony elementów menu"

#: prefs.js
msgid "Show icons on every entry, on the top three (About This PC, System Settings, App Store) only, or on none."
msgstr "Pokazuj ikony przy wszystkich pozycjach, tylko przy trzech pierwszych (O tym komputerze, Ustawienia systemu, Sklep z aplikacjami) lub przy żadnej."

#: prefs.js
msgid "Default"
msgstr "Domyślne"

#: prefs.js
msgid "Three"
msgstr "Trzy"

#: prefs.js
msgid "None"
msgstr "Brak"

#: prefs.js
msgid "Custom Menu Item"
msgstr "Niestandardowy element menu"

#: prefs.js
msgid "Add a custom menu entry with your own label and command."
msgstr "Dodaj niestandardowy wpis menu z własną etykietą i poleceniem."

#: prefs.js
msgid "Menu Label"
msgstr "Etykieta menu"

#: prefs.js
msgid "Command"
msgstr "Polecenie"

#: prefs.js
msgid "Restore Default"
msgstr "Przywróć domyślne"

#: prefs.js
msgid "Choose the icon to display in the panel."
msgstr "Wybierz ikonę do wyświetlenia w panelu."

#: prefs.js
msgid "Panel"
msgstr "Panel"

#: prefs.js
msgid "Hide or show the Activities button from the top bar."
msgstr "Ukryj lub pokaż przycisk Aktywności na górnym pasku."

#: prefs.js
msgid "Hide Activities Menu"
msgstr "Ukryj menu Aktywności"

#: prefs.js
msgid "Display the Activities button in the top panel."
msgstr "Wyświetl przycisk Aktywności w górnym panelu."

#: prefs.js
msgid "Quick Settings"
msgstr "Szybkie ustawienia"

#: prefs.js
msgid "Choose which default quick action buttons stay visible."
msgstr "Wybierz, które domyślne szybkie akcje mają pozostać widoczne."

#: prefs.js
msgid "Hide Lock Screen Button"
msgstr "Ukryj przycisk blokady ekranu"

#: prefs.js
msgid "Remove the lock screen quick action button."
msgstr "Usuwa szybką akcję blokady ekranu."

#: prefs.js
msgid "Hide Power Button"
msgstr "Ukryj przycisk zasilania"

#: prefs.js
msgid "Remove the power menu quick action button."
msgstr "Usuwa szybką akcję menu zasilania."

#: prefs.js
msgid "Hide Settings Button"
msgstr "Ukryj przycisk ustawień"

#: prefs.js
msgid "Remove the settings shortcut quick action button."
msgstr "Usuwa szybką akcję skrótu do Ustawień."

