msgid "Shortcut that runs the custom command."
msgstr "Skrót uruchamiający niestandardowe polecenie."

#: prefs.js
msgid "Set Shortcut"
msgstr "Ustaw skrót"

#: prefs.js
msgid "Press a Shortcut"
msgstr "Naciśnij skrót"

#: prefs.js
msgid "Esc to cancel · Backspace to disable"
msgstr "Esc, aby anulować · Backspace, aby wyłączyć"

#: prefs.js
msgid "Optional image shown next to the menu label."
msgstr "Opcjonalny obraz wyświetlany obok etykiety menu."

#: prefs.js
msgid "Icon"
msgstr "Ikona"

#: prefs.js
msgid "Choose Icon File"
msgstr "Wybierz plik ikony"

#: prefs.js
msgid "Remove Icon"
msgstr "Usuń ikonę"

#: prefs.js
msgid "Selected file was not found."
msgstr "Nie znaleziono wybranego pliku."

#: prefs.js
msgid "Select Custom Menu Icon"
msgstr "Wybierz ikonę niestandardowego elementu menu"

#: prefs.js
msgid "Images"
msgstr "Obrazy"

