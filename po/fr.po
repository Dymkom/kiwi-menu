msgid "Menu Item Icons"
msgstr "Icônes des éléments du menu"

#: prefs.js
msgid "Show icons on every entry, on the top three (About This PC, System Settings, App Store) only, or on none."
msgstr "Afficher les icônes sur toutes les entrées, uniquement sur les trois premières (À propos de ce PC, Paramètres système, Logithèque) ou sur aucune."

#: prefs.js
msgid "Default"
msgstr "Par défaut"

#: prefs.js
msgid "Three"
msgstr "Trois"

#: prefs.js
msgid "None"
msgstr "Aucune"

