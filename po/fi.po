"lisenssin version 3 tai myöhemmän ehtojen mukaisesti."

#: prefs.js
msgid "Become a sponsor on GitHub"
msgstr "Ryhdy sponsoriksi GitHubissa"

#: prefs.js
msgid "Sponsor Me ♡"
msgstr "Sponsoroi minua ♡"

#: prefs.js
msgid "Apply Changes"
msgstr "Käytä muutoksia"

#: prefs.js
msgid "Change log"
msgstr "Muutosloki"

#: prefs.js
msgid "Force Quit Shortcut"
msgstr "Pakota lopetus -pikanäppäin"

#: prefs.js
msgid "Keyboard shortcut that opens the Force Quit window."
msgstr "Pikanäppäin, joka avaa Pakota lopetus -ikkunan."

#: prefs.js
msgid "Clear Shortcut"
msgstr "Tyhjennä pikanäppäin"

#: prefs.js
msgid "Disabled"
msgstr "Pois käytöstä"

#: prefs.js
msgid "macOS Style Shortcuts"
msgstr "macOS-tyyliset pikanäppäimet"

#: prefs.js
msgid "Show accelerator hints using macOS symbols (⌘ ⌥ ^ ⎋)."
msgstr "Näytä pikanäppäinvihjeet macOS-symboleilla (⌘ ⌥ ^ ⎋)."

#: prefs.js
msgid "Keyboard Shortcut"
msgstr "Pikanäppäin"

#: prefs.js
msgid "Shortcut that runs the custom command."
msgstr "Pikanäppäin, joka suorittaa mukautetun komennon."

#: prefs.js
msgid "Set Shortcut"
msgstr "Aseta pikanäppäin"

#: prefs.js
msgid "Press a Shortcut"
msgstr "Paina pikanäppäintä"

#: prefs.js
msgid "Esc to cancel · Backspace to disable"
msgstr "Esc peruuttaa · Askelpalautin poistaa käytöstä"

#: prefs.js
msgid "Optional image shown next to the menu label."
msgstr "Valinnainen kuva, joka näytetään valikon otsikon vieressä."

#: prefs.js
msgid "Icon"
msgstr "Kuvake"

#: prefs.js
msgid "Choose Icon File"
msgstr "Valitse kuvaketiedosto"

#: prefs.js
msgid "Remove Icon"
msgstr "Poista kuvake"

#: prefs.js
msgid "Selected file was not found."
msgstr "Valittua tiedostoa ei löytynyt."

#: prefs.js
msgid "Select Custom Menu Icon"
msgstr "Valitse mukautetun valikkokohdan kuvake"

#: prefs.js
msgid "Images"
msgstr "Kuvat"

