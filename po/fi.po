#: prefs.js
msgid "Options"
msgstr "Asetukset"

#: prefs.js
msgid "Menu"
msgstr "Valikko"

#: prefs.js
msgid "Adjust how the Kiwi Menu looks and behaves."
msgstr "Mukauta Kiwi-valikon ulkonäköä ja toimintaa."

#: prefs.js
msgid "Menu Icon"
msgstr "Valikon kuvake"

#: prefs.js
msgid "App Store Command"
msgstr "Sovelluskaupan komento"

#: prefs.js
msgid "Command launched when opening the App Store menu item."
msgstr "App Store -valikkokohtaa avattaessa käynnistettävä komento."

#: prefs.js
msgid "Menu Item Icons"
msgstr "Valikkokohtien kuvakkeet"

#: prefs.js
msgid "Show icons on every entry, on the top three (About This PC, System Settings, App Store) only, or on none."
msgstr "Näytä kuvakkeet kaikissa kohdissa, vain kolmessa ylimmässä (Tietoja tästä tietokoneesta, Järjestelmäasetukset, Sovelluskauppa) tai ei missään."

#: prefs.js
msgid "Default"
msgstr "Oletus"

#: prefs.js
msgid "Three"
msgstr "Kolme"

#: prefs.js
msgid "None"
msgstr "Ei mitään"

#: prefs.js
msgid "Custom Menu Item"
msgstr "Mukautettu valikkokohta"

#: prefs.js
msgid "Add a custom menu entry with your own label and command."
msgstr "Lisää mukautettu valikkomerkintä omalla otsikolla ja komennolla."

#: prefs.js
msgid "Menu Label"
msgstr "Valikon otsikko"

#: prefs.js
msgid "Command"
msgstr "Komento"

#: prefs.js
msgid "Restore Default"
msgstr "Palauta oletus"

#: prefs.js
msgid "Choose the icon to display in the panel."
msgstr "Valitse paneelissa näytettävä kuvake."

#: prefs.js
msgid "Panel"
msgstr "Paneeli"

#: prefs.js
msgid "Hide or show the Activities button from the top bar."
msgstr "Piilota tai näytä Toiminnot-painike yläpalkissa."

#: prefs.js
msgid "Hide Activities Menu"
msgstr "Piilota Toiminnot-valikko"

#: prefs.js
msgid "Display the Activities button in the top panel."
msgstr "Näytä Toiminnot-painike yläpaneelissa."

#: prefs.js
msgid "Quick Settings"
msgstr "Pika-asetukset"

#: prefs.js
msgid "Choose which default quick action buttons stay visible."
msgstr "Valitse mitkä oletuspikatoimintopainikkeet pysyvät näkyvissä."

#: prefs.js
msgid "Hide Lock Screen Button"
msgstr "Piilota Lukitse näyttö -painike"

#: prefs.js
msgid "Remove the lock screen quick action button."
msgstr "Poistaa lukitusnäytön pikatoimintopainikkeen."

#: prefs.js
msgid "Hide Power Button"
msgstr "Piilota virtapainike"

#: prefs.js
msgid "Remove the power menu quick action button."
msgstr "Poistaa virtavalikon pikatoimintopainikkeen."

#: prefs.js
msgid "Hide Settings Button"
msgstr "Piilota Asetukset-painike"

#: prefs.js
msgid "Remove the settings shortcut quick action button."
msgstr "Poistaa Asetukset-pikakuvakkeen pikatoimintopainikkeen."

