#: app/forceQuitWindow.js
msgid "Force Quit Applications"
msgstr "Beenden von Anwendungen erzwingen"

#: app/forceQuitWindow.js
msgid "If an app doesn't respond for a while, select its name and click Force Quit."
msgstr "Wenn eine App eine Zeit lang nicht reagiert, wählen Sie ihren Namen aus und klicken Sie auf „Beenden erzwingen“."

#: app/aboutWindow.js
msgid "Chip"
msgstr "Chip"

#: app/aboutWindow.js
msgid "Memory"
msgstr "Arbeitsspeicher"

#: app/aboutWindow.js
msgid "OS"
msgstr "Betriebssystem"

#: app/aboutWindow.js
msgid "More Info..."
msgstr "Weitere Informationen..."

#: prefs.js
msgid "Options"
msgstr "Optionen"

#: prefs.js
msgid "Menu"
msgstr "Menü"

#: prefs.js
msgid "Adjust how the Kiwi Menu looks and behaves."
msgstr "Passen Sie das Aussehen und Verhalten des Kiwi-Menüs an."

#: prefs.js
msgid "Menu Icon"
msgstr "Menü-Symbol"

#: prefs.js
msgid "App Store Command"
msgstr "App-Store-Befehl"

#: prefs.js
msgid "Command launched when opening the App Store menu item."
msgstr "Befehl, der beim Öffnen des App-Store-Menüeintrags ausgeführt wird."

#: prefs.js
msgid "Menu Item Icons"
msgstr "Menüeintrag-Symbole"

#: prefs.js
msgid "Show icons on every entry, on the top three (About This PC, System Settings, App Store) only, or on none."
msgstr "Symbole bei allen Einträgen, nur bei den ersten drei (Über diesen PC, Systemeinstellungen, App-Store) oder bei keinem anzeigen."

#: prefs.js
msgid "Default"
msgstr "Standard"

#: prefs.js
msgid "Three"
msgstr "Drei"

#: prefs.js
msgid "None"
msgstr "Keine"

#: prefs.js
msgid "Custom Menu Item"
msgstr "Benutzerdefinierter Menüeintrag"

#: prefs.js
msgid "Add a custom menu entry with your own label and command."
msgstr ""
"Fügen Sie einen benutzerdefinierten Menüeintrag mit eigener Beschriftung und "
"Befehl hinzu."

#: prefs.js
msgid "Menu Label"
msgstr "Menübeschriftung"

#: prefs.js
msgid "Command"
msgstr "Befehl"

#: prefs.js
msgid "Restore Default"
msgstr "Standard wiederherstellen"

#: prefs.js
msgid "Choose the icon to display in the panel."
msgstr "Wählen Sie das Symbol, das im Panel angezeigt werden soll."

#: prefs.js
msgid "Panel"
msgstr "Panel"

#: prefs.js
msgid "Hide or show the Activities button from the top bar."
msgstr ""
"Aktivitäten-Schaltfläche in der oberen Leiste ausblenden oder anzeigen."

#: prefs.js
msgid "Hide Activities Menu"
msgstr "Aktivitätenmenü ausblenden"

#: prefs.js
msgid "Display the Activities button in the top panel."
msgstr "Die Aktivitäten-Schaltfläche im oberen Panel anzeigen."

#: prefs.js
msgid "Quick Settings"
msgstr "Schnelleinstellungen"

#: prefs.js
msgid "Choose which default quick action buttons stay visible."
msgstr "Wählen Sie, welche Standard-Schnellaktionen sichtbar bleiben."

#: prefs.js
msgid "Hide Lock Screen Button"
msgstr "Schaltfläche „Bildschirm sperren“ ausblenden"

#: prefs.js
msgid "Remove the lock screen quick action button."
msgstr "Entfernt die Schnellaktion zum Sperren des Bildschirms."

#: prefs.js
msgid "Hide Power Button"
msgstr "Schaltfläche „Energie“ ausblenden"

#: prefs.js
msgid "Remove the power menu quick action button."
msgstr "Entfernt die Schnellaktion für das Energiemenü."

#: prefs.js
msgid "Hide Settings Button"
msgstr "Schaltfläche „Einstellungen“ ausblenden"

#: prefs.js
msgid "Remove the settings shortcut quick action button."
msgstr "Entfernt die Schnellaktion für die Verknüpfung zu Einstellungen."

#: prefs.js
msgid "About"
msgstr "Über"

#: prefs.js
msgid "Website"
msgstr "Webseite"

#: prefs.js
