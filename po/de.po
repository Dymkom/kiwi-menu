"General Public License Version 3 oder höher."

#: prefs.js
msgid "Become a sponsor on GitHub"
msgstr "Sponsor auf GitHub werden"

#: prefs.js
msgid "Sponsor Me ♡"
msgstr "Unterstütze mich ♡"

#: prefs.js
msgid "Apply Changes"
msgstr "Änderungen anwenden"

#: prefs.js
msgid "Change log"
msgstr "Änderungsprotokoll"

#: prefs.js
msgid "Force Quit Shortcut"
msgstr "Tastenkürzel für „Beenden erzwingen“"

#: prefs.js
msgid "Keyboard shortcut that opens the Force Quit window."
msgstr "Tastenkürzel, das das Fenster „Beenden erzwingen“ öffnet."

#: prefs.js
msgid "Clear Shortcut"
msgstr "Tastenkürzel löschen"

#: prefs.js
msgid "Disabled"
msgstr "Deaktiviert"

#: prefs.js
msgid "macOS Style Shortcuts"
msgstr "Tastenkürzel im macOS-Stil"

#: prefs.js
msgid "Show accelerator hints using macOS symbols (⌘ ⌥ ^ ⎋)."
msgstr "Tastenkürzel-Hinweise mit macOS-Symbolen anzeigen (⌘ ⌥ ^ ⎋)."

#: prefs.js
msgid "Keyboard Shortcut"
msgstr "Tastenkürzel"

#: prefs.js
msgid "Shortcut that runs the custom command."
msgstr "Tastenkürzel, das den benutzerdefinierten Befehl ausführt."

#: prefs.js
msgid "Set Shortcut"
msgstr "Tastenkürzel festlegen"

#: prefs.js
msgid "Press a Shortcut"
msgstr "Tastenkürzel drücken"

#: prefs.js
msgid "Esc to cancel · Backspace to disable"
msgstr "Esc zum Abbrechen · Rücktaste zum Deaktivieren"

#: prefs.js
msgid "Optional image shown next to the menu label."
msgstr "Optionales Bild neben der Menübeschriftung."

#: prefs.js
msgid "Icon"
msgstr "Symbol"

#: prefs.js
msgid "Choose Icon File"
msgstr "Symboldatei auswählen"

#: prefs.js
msgid "Remove Icon"
msgstr "Symbol entfernen"

#: prefs.js
msgid "Selected file was not found."
msgstr "Die ausgewählte Datei wurde nicht gefunden."

#: prefs.js
msgid "Select Custom Menu Icon"
msgstr "Symbol für den benutzerdefinierten Menüeintrag auswählen"

#: prefs.js
msgid "Images"
msgstr "Bilder"

