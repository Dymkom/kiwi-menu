msgid "Shortcut that runs the custom command."
msgstr "Kiirklahv, mis käivitab kohandatud käsu."

#: prefs.js
msgid "Set Shortcut"
msgstr "Määra kiirklahv"

#: prefs.js
msgid "Press a Shortcut"
msgstr "Vajuta kiirklahvi"

#: prefs.js
msgid "Esc to cancel · Backspace to disable"
msgstr "Esc tühistab · Backspace keelab"

#: prefs.js
msgid "Optional image shown next to the menu label."
msgstr "Valikuline pilt, mida kuvatakse menüü sildi kõrval."

