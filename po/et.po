msgid "Menu"
msgstr "Menüü"

#: prefs.js
msgid "Adjust how the Kiwi Menu looks and behaves."
msgstr "Kohanda Kiwi menüü välimust ja käitumist."

#: prefs.js
msgid "Menu Icon"
msgstr "Menüü ikoon"

#: prefs.js
msgid "App Store Command"
msgstr "Rakenduste poe käsk"

#: prefs.js
msgid "Command launched when opening the App Store menu item."
msgstr "Rakenduste poe menüü-elemendi avamisel käivitatav käsk."

#: prefs.js
msgid "Menu Item Icons"
msgstr "Menüüelementide ikoonid"

#: prefs.js
msgid "Show icons on every entry, on the top three (About This PC, System Settings, App Store) only, or on none."
msgstr "Näita ikoone kõigil kirjetel, ainult kolmel esimesel (Teave selle arvuti kohta, Süsteemi seaded, Rakenduste pood) või mitte ühelgi."

#: prefs.js
msgid "Default"
msgstr "Vaikimisi"

#: prefs.js
msgid "Three"
msgstr "Kolm"

#: prefs.js
msgid "None"
msgstr "Puudub"

#: prefs.js
msgid "Custom Menu Item"
msgstr "Kohandatud menüüelement"

#: prefs.js
msgid "Add a custom menu entry with your own label and command."
msgstr "Lisa kohandatud menüükanne oma sildi ja käsuga."

#: prefs.js
msgid "Menu Label"
msgstr "Menüü silt"

#: prefs.js
msgid "Command"
msgstr "Käsk"

#: prefs.js
msgid "Restore Default"
msgstr "Taasta vaikeväärtus"

#: prefs.js
msgid "Choose the icon to display in the panel."
msgstr "Vali paneelil kuvatav ikoon."

#: prefs.js
msgid "Panel"
msgstr "Paneel"

#: prefs.js
msgid "Hide or show the Activities button from the top bar."
msgstr "Peida või kuva tegevuste nupp ülemisel ribal."

#: prefs.js
msgid "Hide Activities Menu"
msgstr "Peida tegevuste menüü"

#: prefs.js
msgid "Display the Activities button in the top panel."
msgstr "Kuva tegevuste nupp ülemises panelis."

#: prefs.js
msgid "Quick Settings"
msgstr "Kiirseaded"

#: prefs.js
msgid "Choose which default quick action buttons stay visible."
msgstr "Vali, millised vaikimisi kiirtoimingute nupud jäävad nähtavaks."

#: prefs.js
msgid "Hide Lock Screen Button"
msgstr "Peida lukustuskuva nupp"

#: prefs.js
msgid "Remove the lock screen quick action button."
msgstr "Eemaldab lukustuskuva kiirtoimingu nupu."

#: prefs.js
msgid "Hide Power Button"
msgstr "Peida toitenupp"

#: prefs.js
msgid "Remove the power menu quick action button."
msgstr "Eemaldab toitemenüü kiirtoimingu nupu."

#: prefs.js
msgid "Hide Settings Button"
msgstr "Peida Seadete nupp"

#: prefs.js
msgid "Remove the settings shortcut quick action button."
msgstr "Eemaldab Seadete otsetee kiirtoimingu nupu."

