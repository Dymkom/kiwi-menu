#: prefs.js
msgid "Force Quit Shortcut"
msgstr "Sunni sulgemise kiirklahv"

#: prefs.js
msgid "Keyboard shortcut that opens the Force Quit window."
msgstr "Kiirklahv, mis avab sunni sulgemise akna."

#: prefs.js
msgid "Clear Shortcut"
msgstr "Tühjenda kiirklahv"

#: prefs.js
msgid "Disabled"
msgstr "Keelatud"

#: prefs.js
msgid "macOS Style Shortcuts"
msgstr "macOS-stiilis kiirklahvid"

#: prefs.js
msgid "Show accelerator hints using macOS symbols (⌘ ⌥ ^ ⎋)."
msgstr "Näita kiirklahvide vihjeid macOS-i sümbolitega (⌘ ⌥ ^ ⎋)."

#: prefs.js
msgid "Keyboard Shortcut"
msgstr "Kiirklahv"

