msgid "Icon"
msgstr "Ikoon"

#: prefs.js
msgid "Choose Icon File"
msgstr "Vali ikoonifail"

#: prefs.js
msgid "Remove Icon"
msgstr "Eemalda ikoon"

#: prefs.js
msgid "Selected file was not found."
msgstr "Valitud faili ei leitud."

#: prefs.js
msgid "Select Custom Menu Icon"
msgstr "Vali kohandatud menüüelemendi ikoon"

