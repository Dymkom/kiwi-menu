msgid "Add a custom menu entry with your own label and command."
msgstr "Legg til et tilpasset menyinnslag med din egen etikett og kommando."

#: prefs.js
msgid "Menu Label"
msgstr "Menyetikett"

#: prefs.js
msgid "Command"
msgstr "Kommando"

