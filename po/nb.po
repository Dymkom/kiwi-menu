msgid "Show icons on every entry, on the top three (About This PC, System Settings, App Store) only, or on none."
msgstr "Vis ikoner på alle elementer, bare på de tre øverste (Om denne PC-en, Systeminnstillinger, App Store) eller på ingen."

#: prefs.js
msgid "Default"
msgstr "Standard"

#: prefs.js
msgid "Three"
msgstr "Tre"

#: prefs.js
msgid "None"
msgstr "Ingen"

